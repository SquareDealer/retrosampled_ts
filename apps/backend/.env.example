NODE_ENV=development
PORT=3000

# --- Database -------------------------------------------------------------
DATABASE_URL=postgresql://retro:retro@127.0.0.1:5432/retrosamples?schema=public

# --- Auth -----------------------------------------------------------------
# Symmetric secret used to sign/verify access & refresh JWTs (>= 16 chars).
JWT_SECRET=change-me
JWT_ACCESS_TTL=3600        # access token lifetime in seconds
JWT_REFRESH_TTL=2592000    # refresh token lifetime in seconds (30 days)

# Base URL of the frontend SPA — used to build verification/reset links.
APP_URL=http://localhost:5173

# --- CORS & cookies (cross-domain prod) -----------------------------------
# Comma-separated allowed origins. Leave empty in dev to reflect any origin.
# CORS_ORIGIN=https://app.retrosamples.dev
# COOKIE_SAMESITE=lax        # use "none" when SPA and API are on different domains
# COOKIE_SECURE=false        # defaults to true in production / when SameSite=none
# COOKIE_DOMAIN=.retrosamples.dev

# --- Object storage -------------------------------------------------------
# Driver: "local" (default, files served at /uploads) or "s3".
STORAGE_DRIVER=local
# STORAGE_LOCAL_DIR=./uploads
# STORAGE_PUBLIC_URL=http://localhost:3000     # base URL used in returned audio URLs
# For the s3 driver (AWS S3 / Cloudflare R2 / MinIO):
# STORAGE_BUCKET=retrosamples
# STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# STORAGE_REGION=auto
# STORAGE_ACCESS_KEY=...
# STORAGE_SECRET_KEY=...
# STORAGE_PUBLIC_URL=https://cdn.retrosamples.dev   # public/CDN base for the bucket

# --- Email (transactional) ------------------------------------------------
# Without RESEND_API_KEY, links are logged to the server console (dev).
# RESEND_API_KEY=re_...
# MAIL_FROM=Retrosamples <noreply@retrosamples.dev>

# --- Rate limiting --------------------------------------------------------
# THROTTLE_TTL=60000         # window in ms
# THROTTLE_LIMIT=1000        # global requests per window per IP
# AUTH_THROTTLE_LIMIT=50     # auth requests per window per IP
