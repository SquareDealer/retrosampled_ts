# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Comma-separated list of origins allowed to send credentialed requests
CORS_ORIGIN=http://localhost:5173

# --- Database ----------------------------------------------------------------
# SQLite file, relative to apps/backend/prisma
DATABASE_URL="file:./dev.db"

# --- Auth --------------------------------------------------------------------
# Required. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string
# Access token lifetime in seconds (15 min)
JWT_ACCESS_TTL=900
# Refresh token lifetime in seconds (30 days, matches the refresh cookie max-age)
JWT_REFRESH_TTL=2592000

# --- Storage -----------------------------------------------------------------
# local | s3
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:3000
MAX_UPLOAD_MB=50
# native | audiowaveform
PEAKS_DRIVER=native

# Only required when STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
