{
  "name": "retrosampled-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --parallel",
    "dev:backend": "pnpm --filter @retrosampled/backend dev",
    "dev:frontend": "pnpm --filter @retrosampled/frontend dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "turbo": "^2.1.3"
  }
}
