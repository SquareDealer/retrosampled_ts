{
  "name": "retrosampled-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --parallel",
    "dev:backend": "pnpm --filter @retrosampled/backend dev",
    "dev:frontend": "pnpm --filter @retrosampled/frontend dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "agentation": "^3.0.2",
    "turbo": "^2.1.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "prisma",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "@nestjs/core"
    ]
  }
}
